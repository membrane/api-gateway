<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <Console name="STDOUT" target="SYSTEM_OUT">
            <PatternLayout charset="UTF-8"
                           disableAnsi="${sys:membrane.disable.term.colors:-false}"
                           pattern="%d{ABSOLUTE} %highlight{%5p}{ERROR=red, WARN=yellow, INFO=cyan} %tid %tn %c{1}:%L %X - %m%n"/>
        </Console>
        <RollingFile name="TRAFFIC" fileName="traffic.log" filePattern="traffic-%i.log">
            <PatternLayout pattern="%d{ABSOLUTE} %5p %tid %tn %c{1}:%L - %m%n" />
            <Policies>
                <SizeBasedTriggeringPolicy size="100 MB" />
            </Policies>
            <DefaultRolloverStrategy max="10" />
        </RollingFile>
    </Appenders>
    <Loggers>
        <!-- TRACE on this logger turns byte stream logging on. HTTPS traffic is written in clear text. -->
        <Logger name="com.predic8.membrane.core.transport.http.ByteStreamLogging" level="trace" additivity="false">
            <AppenderRef ref="TRAFFIC" />
        </Logger>
        <Logger name="com.predic8" level="info" additivity="false">
            <AppenderRef ref="STDOUT" />
        </Logger>
        <Root level="info">
            <AppenderRef ref="STDOUT" />
        </Root>
    </Loggers>
</Configuration>
