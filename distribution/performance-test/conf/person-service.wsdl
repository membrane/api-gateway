<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic legacy SOAP service for the wsdl2openapi performance-test scenario: one
     document/literal operation, createPerson, whose request carries a person with 10 scalar
     fields, one array (hobby) and one nested object (address, 7 fields), and whose response
     element is empty. The soap:address below is a placeholder; loadtest-wsdl2openapi.xml sets the
     real backend address via <target url="..."/>. -->
<wsdl:definitions
        xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
        xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        xmlns:tns="http://example.com/person"
        targetNamespace="http://example.com/person">

    <wsdl:types>
        <xsd:schema targetNamespace="http://example.com/person">

            <xsd:complexType name="Address">
                <xsd:sequence>
                    <xsd:element name="street" type="xsd:string"/>
                    <xsd:element name="houseNumber" type="xsd:string"/>
                    <xsd:element name="postalCode" type="xsd:string"/>
                    <xsd:element name="city" type="xsd:string"/>
                    <xsd:element name="region" type="xsd:string"/>
                    <xsd:element name="country" type="xsd:string"/>
                    <xsd:element name="additionalInfo" type="xsd:string" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="Person">
                <xsd:sequence>
                    <xsd:element name="firstName" type="xsd:string"/>
                    <xsd:element name="lastName" type="xsd:string"/>
                    <xsd:element name="email" type="xsd:string"/>
                    <xsd:element name="phone" type="xsd:string"/>
                    <xsd:element name="dateOfBirth" type="xsd:date"/>
                    <xsd:element name="heightCm" type="xsd:int"/>
                    <xsd:element name="weightKg" type="xsd:decimal"/>
                    <xsd:element name="newsletter" type="xsd:boolean"/>
                    <xsd:element name="customerNumber" type="xsd:long"/>
                    <xsd:element name="nationality" type="xsd:string"/>
                    <xsd:element name="hobby" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
                    <xsd:element name="address" type="tns:Address"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:element name="createPerson">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="person" type="tns:Person"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="createPersonResponse">
                <xsd:complexType/>
            </xsd:element>

        </xsd:schema>
    </wsdl:types>

    <wsdl:message name="createPersonRequest">
        <wsdl:part name="parameters" element="tns:createPerson"/>
    </wsdl:message>
    <wsdl:message name="createPersonResponse">
        <wsdl:part name="parameters" element="tns:createPersonResponse"/>
    </wsdl:message>

    <wsdl:portType name="PersonService">
        <wsdl:operation name="createPerson">
            <wsdl:input message="tns:createPersonRequest"/>
            <wsdl:output message="tns:createPersonResponse"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="PersonServiceSoapBinding" type="tns:PersonService">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="createPerson">
            <soap:operation soapAction="createPerson"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input>
            <wsdl:output><soap:body use="literal"/></wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="PersonService">
        <wsdl:port name="PersonServicePort" binding="tns:PersonServiceSoapBinding">
            <soap:address location="http://localhost:2012/person-service"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
