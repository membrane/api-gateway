<?xml version="1.0" encoding="UTF-8"?>
<!-- One port type offered over several transports. Only SOAP over HTTP can be called; the JMS port
     comes first so that document order alone would pick it. -->
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:tns="http://example.com/orders"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  xmlns:s="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:s12="http://schemas.xmlsoap.org/wsdl/soap12/"
                  targetNamespace="http://example.com/orders">
    <wsdl:types>
        <xsd:schema targetNamespace="http://example.com/orders" elementFormDefault="qualified">
            <xsd:element name="order">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="item" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="orderResponse" type="xsd:string"/>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="order">
        <wsdl:part name="parameters" element="tns:order"/>
    </wsdl:message>
    <wsdl:message name="orderResponse">
        <wsdl:part name="parameters" element="tns:orderResponse"/>
    </wsdl:message>
    <wsdl:portType name="OrderPortType">
        <wsdl:operation name="order">
            <wsdl:input message="tns:order"/>
            <wsdl:output message="tns:orderResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="OrderJmsBinding" type="tns:OrderPortType">
        <s:binding style="document" transport="http://www.w3.org/2010/soapjms/"/>
        <wsdl:operation name="order">
            <s:operation soapAction="http://example.com/orders/order"/>
            <wsdl:input><s:body use="literal"/></wsdl:input>
            <wsdl:output><s:body use="literal"/></wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:binding name="OrderHttpBinding" type="tns:OrderPortType">
        <s:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="order">
            <s:operation soapAction="http://example.com/orders/order"/>
            <wsdl:input><s:body use="literal"/></wsdl:input>
            <wsdl:output><s:body use="literal"/></wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:binding name="OrderNoTransportBinding" type="tns:OrderPortType">
        <s:binding style="document"/>
        <wsdl:operation name="order">
            <s:operation soapAction="http://example.com/orders/order"/>
            <wsdl:input><s:body use="literal"/></wsdl:input>
            <wsdl:output><s:body use="literal"/></wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:binding name="OrderSoap12Binding" type="tns:OrderPortType">
        <s12:binding style="document" transport="http://www.w3.org/2003/05/soap/bindings/HTTP/"/>
        <wsdl:operation name="order">
            <s12:operation soapAction="http://example.com/orders/order"/>
            <wsdl:input><s12:body use="literal"/></wsdl:input>
            <wsdl:output><s12:body use="literal"/></wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <!-- No port uses it: the URI is not standard, but found in the wild. -->
    <wsdl:binding name="OrderSoap12NonstandardBinding" type="tns:OrderPortType">
        <s12:binding style="document" transport="http://schemas.xmlsoap.org/soap12/http"/>
        <wsdl:operation name="order">
            <s12:operation soapAction="http://example.com/orders/order"/>
            <wsdl:input><s12:body use="literal"/></wsdl:input>
            <wsdl:output><s12:body use="literal"/></wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="OrderService">
        <wsdl:port name="OrderJmsPort" binding="tns:OrderJmsBinding">
            <s:address location="jms:jndi:dynamicQueues/orders"/>
        </wsdl:port>
        <wsdl:port name="OrderHttpPort" binding="tns:OrderHttpBinding">
            <s:address location="http://example.com/orders"/>
        </wsdl:port>
        <wsdl:port name="OrderNoTransportPort" binding="tns:OrderNoTransportBinding">
            <s:address location="http://example.com/orders-no-transport"/>
        </wsdl:port>
        <wsdl:port name="OrderSoap12Port" binding="tns:OrderSoap12Binding">
            <s12:address location="http://example.com/orders-soap12"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
