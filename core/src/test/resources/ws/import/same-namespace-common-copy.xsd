<?xml version="1.0" encoding="UTF-8"?>
<!-- Conflicts with same-namespace-common.xsd and also declares a global element of its own. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="https://example.com/same-namespace/types"
           targetNamespace="https://example.com/same-namespace/types"
           elementFormDefault="qualified">
    <xs:simpleType name="CategoryType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Plane"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:element name="category" type="t:CategoryType"/>
</xs:schema>
