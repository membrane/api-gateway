<?xml version="1.0" encoding="UTF-8"?>
<!-- Imports one namespace from two schema documents: the request elements from one, the response
     elements from the other. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:import namespace="https://example.com/same-namespace/types" schemaLocation="same-namespace-request.xsd"/>
    <xs:import namespace="https://example.com/same-namespace/types" schemaLocation="same-namespace-response.xsd"/>
</xs:schema>
