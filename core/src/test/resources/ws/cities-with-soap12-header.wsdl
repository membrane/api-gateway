<?xml version="1.0" encoding="UTF-8"?>
<!--
    Like cities-with-soap-header.wsdl, but with a SOAP 1.2 binding: the header blocks are bound via
    soap12:header and soap12:headerfault.
-->
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:cs="https://example.com/cities"
                  xmlns:hd="https://example.com/header"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  xmlns:s12="http://schemas.xmlsoap.org/wsdl/soap12/"
                  targetNamespace="https://example.com/cities" name="cities">
    <wsdl:types>
        <xsd:schema targetNamespace="https://example.com/header" elementFormDefault="qualified">
            <xsd:element name="RequestHeader">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="MessageId" type="xsd:string"/>
                        <xsd:element name="Language" type="xsd:language"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="HeaderFault">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="Reason" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:schema>
        <xsd:schema targetNamespace="https://example.com/cities">
            <xsd:element name="getCity">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="name" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="getCityResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="population" type="xsd:integer"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="City">
        <wsdl:part name="header" element="hd:RequestHeader"/>
        <wsdl:part name="body" element="cs:getCity"/>
    </wsdl:message>
    <wsdl:message name="CityResponse">
        <wsdl:part name="body" element="cs:getCityResponse"/>
    </wsdl:message>
    <wsdl:message name="HeaderFault">
        <wsdl:part name="fault" element="hd:HeaderFault"/>
    </wsdl:message>
    <wsdl:portType name="CityPort">
        <wsdl:operation name="getCity">
            <wsdl:input message="cs:City"/>
            <wsdl:output message="cs:CityResponse"/>
        </wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="CitySoap12Binding" type="cs:CityPort">
        <s12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="getCity">
            <s12:operation soapAction="https://example.com/cities/getCity"/>
            <wsdl:input>
                <s12:header use="literal" message="cs:City" part="header">
                    <s12:headerfault use="literal" message="cs:HeaderFault" part="fault"/>
                </s12:header>
                <s12:body use="literal" parts="body"/>
            </wsdl:input>
            <wsdl:output>
                <s12:body use="literal"/>
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="CityService">
        <wsdl:port name="CityPort" binding="cs:CitySoap12Binding">
            <s12:address location="https://example.com/cities"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
