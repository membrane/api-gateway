<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tests: the global element "note" is declared in two namespaces, here and in the imported
  notes-b.xsd, so its JSON key has to carry the namespace.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="https://example.com/a"
           elementFormDefault="qualified">

    <xs:import namespace="https://example.com/b" schemaLocation="notes-b.xsd"/>

    <xs:element name="note">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="count" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
